# Kingdom Discord Bots - Environment Configuration
# ================================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ===================
# Discord Bot Tokens
# ===================
# Create bots at: https://discord.com/developers/applications
# Each bot needs its own token

# Alpha Bot Token (VPS 1)
KINGDOM_ALPHA_TOKEN=your_alpha_bot_token_here

# Beta Bot Token (VPS 2)
KINGDOM_BETA_TOKEN=your_beta_bot_token_here

# Gamma Bot Token (VPS 3)
KINGDOM_GAMMA_TOKEN=your_gamma_bot_token_here

# Delta Bot Token (VPS 4)
KINGDOM_DELTA_TOKEN=your_delta_bot_token_here

# ===================
# Guild Configuration
# ===================
# Optional: Set guild IDs for faster command sync
# Commands sync instantly to specific guilds vs up to 1 hour globally

KINGDOM_ALPHA_GUILD_ID=
KINGDOM_BETA_GUILD_ID=
KINGDOM_GAMMA_GUILD_ID=
KINGDOM_DELTA_GUILD_ID=

# ===================
# Admin Configuration
# ===================
# Discord user IDs with admin access to all bots
# Find your ID: Enable Developer Mode in Discord, right-click your name

KINGDOM_ADMIN_USER_1=
KINGDOM_ADMIN_USER_2=

# Discord role ID with admin access
KINGDOM_ADMIN_ROLE=

# ===================
# Logging
# ===================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
KINGDOM_LOG_LEVEL=INFO
