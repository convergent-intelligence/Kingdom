# Kingdom Bot {{ bot_id | capitalize }} Environment Configuration
# Generated by Ansible on {{ ansible_date_time.iso8601 | default('N/A') }}

# Discord Bot Token (REQUIRED)
KINGDOM_{{ bot_id | upper }}_TOKEN={{ bot_token | default('your_discord_bot_token_here') }}

# Discord Guild ID (optional, for faster command sync)
KINGDOM_{{ bot_id | upper }}_GUILD_ID={{ guild_id | default('') }}

# Admin User IDs
KINGDOM_ADMIN_USER_1={{ admin_user_1 | default('') }}
KINGDOM_ADMIN_USER_2={{ admin_user_2 | default('') }}

# Admin Role ID
KINGDOM_ADMIN_ROLE={{ admin_role | default('') }}
